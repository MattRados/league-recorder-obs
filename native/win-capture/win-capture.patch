index cdecf9c..8d59695 100644
--- a/deps/ipc-util/ipc-util/pipe-windows.c
+++ b/deps/ipc-util/ipc-util/pipe-windows.c
@@ -141,6 +141,14 @@ static DWORD CALLBACK ipc_pipe_internal_server_thread(LPVOID param)
 		DWORD wait = WaitForMultipleObjects(_countof(handles), handles,
 						    FALSE, INFINITE);
 		if (wait != WAIT_OBJECT_0) {
+			/* League Recorder: told to stop with the read still
+			 * pending. Windows would still copy a message that
+			 * arrives into buf after this thread has left it (and
+			 * reused that stack for its exit), so cancel the read
+			 * and wait until it has really finished. */
+			CancelIoEx(pipe->handle, &pipe->overlap);
+			GetOverlappedResult(pipe->handle, &pipe->overlap,
+					    &bytes, true);
 			break;
 		}
 
